rules_version = '2';

// Loyi runs on the free Spark plan, so there are no Cloud Functions: clients
// write stamps, rewards and account merges themselves, and these rules are the
// server-side referee. Every write must be exactly what the app would do:
// +1 stamp from an active stamp tag of that card, cooldown respected, one log
// entry per stamp, a reward only when one is available, and so on.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Business owners must use a real account, not an anonymous client session.
    function isBusinessUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function ownsBusiness(businessId) {
      return isBusinessUser()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == uid();
    }

    // Writes to business-owned docs must keep ownerUid/businessId consistent and owned.
    function validOwnedWrite() {
      return request.resource.data.ownerUid == uid()
        && ownsBusiness(request.resource.data.businessId)
        && (resource == null
            || (resource.data.ownerUid == uid()
                && resource.data.businessId == request.resource.data.businessId));
    }

    function cardPath(cardId) {
      return /databases/$(database)/documents/cards/$(cardId);
    }

    function programOf(programId) {
      return get(/databases/$(database)/documents/programs/$(programId)).data;
    }

    function tagOf(tagId) {
      return get(/databases/$(database)/documents/tags/$(tagId)).data;
    }

    // Tags only work while the business owner has an active subscription.
    // subscriptions/{ownerUid} is written by the billing server (billing-worker/),
    // never by the app.
    function subscribed(ownerUid) {
      let path = /databases/$(database)/documents/subscriptions/$(ownerUid);
      return exists(path) && get(path).data.expiresAt > request.time;
    }

    // The anonymous account `fromUid` handed its cards to the signed-in user.
    function transferredToMe(fromUid) {
      let path = /databases/$(database)/documents/transfers/$(fromUid);
      return exists(path) && get(path).data.toUid == uid();
    }

    // ── Businesses, programs, logos ────────────────────────────────────────

    function validBusiness(data) {
      return data.keys().hasOnly(['ownerUid', 'name', 'color', 'colors', 'logoVersion', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.color is int
        && (!('colors' in data) || validBrandColors(data.colors))
        && (!('logoVersion' in data) || data.logoVersion is int);
    }

    // 1 to 3 brand colours (ARGB ints), chosen during sign-up.
    function validBrandColors(c) {
      return c is list && c.size() >= 1 && c.size() <= 3
        && c[0] is int
        && (c.size() < 2 || c[1] is int)
        && (c.size() < 3 || c[2] is int);
    }

    function validDesign(d) {
      return d is map
        && d.keys().hasOnly(['background', 'background2', 'style', 'stampColor', 'stampIcon'])
        && d.background is int
        && (d.get('background2', null) == null || d.background2 is int)
        && d.style in ['solid', 'gradient', 'pattern']
        && d.stampColor is int
        && d.stampIcon is string
        && d.stampIcon.size() <= 30;
    }

    match /businesses/{businessId} {
      allow read: if true; // name, colour and logo are shown on client cards
      allow create: if isBusinessUser()
        && request.resource.data.ownerUid == uid()
        && validBusiness(request.resource.data);
      allow update: if isBusinessUser()
        && resource.data.ownerUid == uid()
        && request.resource.data.ownerUid == uid()
        && validBusiness(request.resource.data);
      // Account deletion; the app removes programs, tags and logs first.
      allow delete: if isBusinessUser() && resource.data.ownerUid == uid();
    }

    // Logos live in Firestore (no Cloud Storage on Spark): one small image per business.
    match /logos/{businessId} {
      allow read: if true;
      allow create, update: if ownsBusiness(businessId)
        && request.resource.data.keys().hasOnly(['data', 'contentType', 'updatedAt'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 200 * 1024
        && request.resource.data.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if ownsBusiness(businessId);
    }

    function validProgram(d) {
      return d.keys().hasOnly(['businessId', 'ownerUid', 'name', 'stampsRequired', 'stampCooldownMinutes',
                               'rewards', 'active', 'design', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 60
        && d.active is bool
        && d.stampsRequired is int
        && d.stampsRequired >= 1
        && d.stampsRequired <= 50
        && d.stampCooldownMinutes is int
        && d.stampCooldownMinutes >= 0
        && d.stampCooldownMinutes <= 7 * 24 * 60
        && d.rewards is list
        && d.rewards.size() <= 20
        && (!('design' in d) || validDesign(d.design));
    }

    match /programs/{programId} {
      allow read: if true; // clients need the name, stamp count and rewards
      allow create, update: if validOwnedWrite() && validProgram(request.resource.data);
      // Only for account deletion (the app pauses cards instead of deleting them).
      allow delete: if isBusinessUser() && resource.data.ownerUid == uid();
    }

    // ── Tags ───────────────────────────────────────────────────────────────

    function validTagLabel(label) {
      return label is string && label.size() > 0 && label.size() <= 40;
    }

    match /tags/{tagId} {
      // Anyone holding a tag id (from tapping it) may look it up; listing is owner-only.
      allow get: if signedIn();
      allow list: if isBusinessUser() && resource.data.ownerUid == uid();
      allow create: if validOwnedWrite()
        && request.resource.data.keys().hasOnly(['businessId', 'ownerUid', 'programId', 'type', 'label', 'active',
                                                 'tapCount', 'createdAt'])
        && request.resource.data.type in ['join', 'stamp']
        && validTagLabel(request.resource.data.label)
        && request.resource.data.active is bool
        && request.resource.data.tapCount == 0
        && get(/databases/$(database)/documents/programs/$(request.resource.data.programId)).data.businessId
           == request.resource.data.businessId;
      allow update: if
        // Owner: rename or (de)activate.
        (validOwnedWrite()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'label'])
         && request.resource.data.active is bool
         && validTagLabel(request.resource.data.label))
        // Client tapping an active tag: tap counter +1.
        || (signedIn()
            && resource.data.active
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tapCount', 'lastTapAt'])
            && request.resource.data.tapCount == resource.data.tapCount + 1
            && request.resource.data.lastTapAt == request.time);
      allow delete: if isBusinessUser() && resource.data.ownerUid == uid(); // account deletion
    }

    // ── Cards ──────────────────────────────────────────────────────────────

    function cardKeys() {
      return ['clientUid', 'businessId', 'ownerUid', 'programId', 'stamps', 'rewardsAvailable', 'totalStamps',
              'totalRedeemed', 'lastStampAt', 'lastTagId', 'lastTicketId', 'mergedFrom', 'createdAt', 'updatedAt'];
    }

    // A stamp from a secure tag (starter kit, NTAG 424 DNA) must spend a ticket the server issued
    // to this client for this tag when it checked the tag's one-time link (billing-worker /kit-tap).
    // Plain tags don't need one.
    function ticketOk(tag, d) {
      return !tag.get('secure', false) || ('lastTicketId' in d && validTicket(d));
    }

    function validTicket(d) {
      let path = /databases/$(database)/documents/stampTickets/$(d.lastTicketId);
      let t = get(path).data;
      return t.clientUid == uid() && t.tagId == d.lastTagId && t.expiresAt > request.time && !existsAfter(path);
    }

    // First tap on any tag of a program creates the card (a stamp tag also gives the first stamp).
    function validJoin(cardId) {
      let d = request.resource.data;
      let tag = tagOf(d.lastTagId);
      let p = programOf(d.programId);
      return d.keys().hasOnly(cardKeys())
        && !('mergedFrom' in d)
        && d.clientUid == uid()
        && cardId == d.programId + '_' + uid()
        && tag.active && tag.programId == d.programId
        && p.active && d.businessId == p.businessId && d.ownerUid == p.ownerUid
        && subscribed(p.ownerUid)
        && d.totalRedeemed == 0
        && d.createdAt == request.time && d.updatedAt == request.time
        && (tag.type == 'join'
            ? d.stamps == 0 && d.rewardsAvailable == 0 && d.totalStamps == 0 && d.lastStampAt == null
            : d.totalStamps == 1
              && d.stamps == 1 % p.stampsRequired
              && d.rewardsAvailable == math.floor(1 / p.stampsRequired)
              && d.lastStampAt == request.time
              && ticketOk(tag, d));
    }

    // Exactly one stamp from an active stamp tag of this card, after the cooldown.
    function validStamp() {
      let old = resource.data;
      let d = request.resource.data;
      let tag = tagOf(d.lastTagId);
      let p = programOf(old.programId);
      let next = old.stamps + 1;
      return d.diff(old).affectedKeys().hasOnly(['stamps', 'rewardsAvailable', 'totalStamps', 'lastStampAt', 'lastTagId',
                                                 'lastTicketId', 'updatedAt'])
        && tag.type == 'stamp' && tag.active && tag.programId == old.programId
        && ticketOk(tag, d)
        && p.active
        && subscribed(old.ownerUid)
        && (old.lastStampAt == null
            || request.time >= old.lastStampAt + duration.value(p.stampCooldownMinutes * 60, 's'))
        && d.totalStamps == old.totalStamps + 1
        && d.stamps == next % p.stampsRequired
        && d.rewardsAvailable == old.rewardsAvailable + math.floor(next / p.stampsRequired)
        && d.lastStampAt == request.time
        && d.updatedAt == request.time;
    }

    // One banked full card spent, always together with its redemption record.
    // Deliberately not gated on the subscription: clients keep rewards they earned.
    function validRedeem(cardId) {
      let old = resource.data;
      let d = request.resource.data;
      return d.diff(old).affectedKeys().hasOnly(['rewardsAvailable', 'totalRedeemed', 'updatedAt'])
        && old.rewardsAvailable >= 1
        && d.rewardsAvailable == old.rewardsAvailable - 1
        && d.totalRedeemed == old.totalRedeemed + 1
        && d.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/redemptions/$(cardId + '_r' + string(d.totalRedeemed)));
    }

    // Merge an anonymous device's card (source, deleted in the same write) into this account's card.
    function validMergeCreate(cardId) {
      let d = request.resource.data;
      let srcPath = cardPath(d.programId + '_' + d.mergedFrom);
      let src = get(srcPath).data;
      return d.keys().hasOnly(cardKeys())
        && transferredToMe(d.mergedFrom)
        && !existsAfter(srcPath)
        && d.clientUid == uid()
        && cardId == d.programId + '_' + uid()
        && d.businessId == src.businessId && d.ownerUid == src.ownerUid
        && d.stamps == src.stamps && d.rewardsAvailable == src.rewardsAvailable
        && d.totalStamps == src.totalStamps && d.totalRedeemed == src.totalRedeemed
        && d.lastStampAt == src.lastStampAt
        && !('lastTagId' in d)
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    function validMergeUpdate() {
      let old = resource.data;
      let d = request.resource.data;
      let srcPath = cardPath(old.programId + '_' + d.mergedFrom);
      let src = get(srcPath).data;
      let p = programOf(old.programId);
      let sum = old.stamps + src.stamps;
      return d.diff(old).affectedKeys().hasOnly(['stamps', 'rewardsAvailable', 'totalStamps', 'totalRedeemed', 'mergedFrom', 'updatedAt'])
        && transferredToMe(d.mergedFrom)
        && !existsAfter(srcPath)
        && d.stamps == sum % p.stampsRequired
        && d.rewardsAvailable == old.rewardsAvailable + src.rewardsAvailable + math.floor(sum / p.stampsRequired)
        && d.totalStamps == old.totalStamps + src.totalStamps
        && d.totalRedeemed == old.totalRedeemed + src.totalRedeemed
        && d.updatedAt == request.time;
    }

    match /cards/{cardId} {
      // A card that doesn't exist yet may be read by its future owner (<programId>_<uid>).
      allow get: if signedIn()
        && (resource == null
            ? cardId.matches('^[^_]+_' + uid() + '$')
            : (resource.data.clientUid == uid()
               || resource.data.ownerUid == uid()
               || transferredToMe(resource.data.clientUid)));
      allow list: if signedIn()
        && (resource.data.clientUid == uid() || resource.data.ownerUid == uid());
      allow create: if signedIn()
        && (validJoin(cardId) || ('mergedFrom' in request.resource.data && validMergeCreate(cardId)));
      allow update: if signedIn()
        && resource.data.clientUid == uid()
        && request.resource.data.clientUid == uid()
        && (validStamp()
            || validRedeem(cardId)
            || ('mergedFrom' in request.resource.data && validMergeUpdate()));
      allow delete: if signedIn()
        && (
          // The merge target removes a merged source card.
          (transferredToMe(resource.data.clientUid)
           && getAfter(cardPath(resource.data.programId + '_' + uid())).data.mergedFrom == resource.data.clientUid)
          // Account deletion: a client removes their own cards, a business the cards of its programs.
          || resource.data.clientUid == uid()
          || (isBusinessUser() && resource.data.ownerUid == uid()));
    }

    // ── Logs ───────────────────────────────────────────────────────────────

    // One event per stamp (id = <cardId>_<totalStamps>), only in the same write as that stamp.
    function validStampEvent(eventId) {
      let d = request.resource.data;
      let card = getAfter(cardPath(d.cardId)).data;
      return d.keys().hasOnly(['businessId', 'ownerUid', 'programId', 'cardId', 'clientUid', 'tagId', 'createdAt'])
        && d.clientUid == uid() && card.clientUid == uid()
        && eventId == d.cardId + '_' + string(card.totalStamps)
        && card.lastStampAt == request.time
        && card.lastTagId == d.tagId
        && d.businessId == card.businessId && d.ownerUid == card.ownerUid && d.programId == card.programId
        && d.createdAt == request.time;
    }

    match /stampEvents/{eventId} {
      // The business reads its log; a client reads their own stamps (GDPR data export).
      allow read: if (isBusinessUser() && resource.data.ownerUid == uid())
        || (signedIn() && resource.data.clientUid == uid());
      allow create: if signedIn() && validStampEvent(eventId);
      allow update: if false;
      allow delete: if isBusinessUser() && resource.data.ownerUid == uid(); // account deletion
    }

    // One record per redeemed reward (id = <cardId>_r<totalRedeemed>), with an active reward of the program.
    function validRedemption(redemptionId) {
      let d = request.resource.data;
      let card = getAfter(cardPath(d.cardId)).data;
      let before = get(cardPath(d.cardId)).data;
      return d.keys().hasOnly(['businessId', 'ownerUid', 'programId', 'cardId', 'clientUid', 'rewardId', 'rewardTitle', 'createdAt'])
        && d.clientUid == uid() && card.clientUid == uid()
        && redemptionId == d.cardId + '_r' + string(card.totalRedeemed)
        && card.totalRedeemed == before.totalRedeemed + 1
        && d.businessId == card.businessId && d.ownerUid == card.ownerUid && d.programId == card.programId
        && {'id': d.rewardId, 'title': d.rewardTitle, 'active': true} in programOf(d.programId).rewards
        && d.createdAt == request.time;
    }

    match /redemptions/{redemptionId} {
      allow read: if signedIn()
        && (resource.data.clientUid == uid() || resource.data.ownerUid == uid());
      allow create: if signedIn() && validRedemption(redemptionId);
      allow update: if false;
      allow delete: if isBusinessUser() && resource.data.ownerUid == uid(); // account deletion
    }

    // ── Follow-up messages ─────────────────────────────────────────────────

    // A short in-app note from a shop to a group of its card holders. It holds no
    // personal data: the group is matched on the client's own device.
    function validMessage(d) {
      return d.keys().hasOnly(['businessId', 'ownerUid', 'programId', 'title', 'body', 'audience', 'active',
                               'endsAt', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.body is string && d.body.size() > 0 && d.body.size() <= 240
        // No links: messages must not become a phishing channel.
        && !d.title.lower().matches('.*(https?:|www[.]).*')
        && !d.body.lower().matches('.*(https?:|www[.]).*')
        && d.audience in ['all', 'newcomers', 'almost', 'reward', 'slipping', 'lost']
        && d.active is bool
        && d.endsAt is timestamp
        && d.endsAt < request.time + duration.value(62, 'd')
        && d.updatedAt == request.time
        && (d.programId == null || programOf(d.programId).businessId == d.businessId);
    }

    match /messages/{messageId} {
      allow read: if true; // shown on client cards, like the program itself
      allow create: if validOwnedWrite()
        && validMessage(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if validOwnedWrite()
        && validMessage(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isBusinessUser() && resource.data.ownerUid == uid();
    }

    // ── Account merge hand-off ─────────────────────────────────────────────

    // An anonymous device session names the account it hands its cards to.
    match /transfers/{fromUid} {
      allow get: if signedIn() && (uid() == fromUid || resource.data.toUid == uid());
      allow create, update: if signedIn()
        && uid() == fromUid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['toUid', 'createdAt'])
        && request.resource.data.toUid is string
        && request.resource.data.toUid != fromUid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && uid() == fromUid;
    }

    // ── Subscriptions ──────────────────────────────────────────────────────

    // {expiresAt, ...} per business owner, written only by the billing server
    // (service account, bypasses these rules). Readable so a client's tap can
    // explain why a shop's tags are paused.
    match /subscriptions/{ownerUid} {
      allow get: if true;
      allow list, write: if false;
    }

    // Stripe customer/subscription ids, for the billing server only.
    match /billing/{ownerUid} {
      allow read, write: if false;
    }

    // Secure tags: the server's record per physical tag (UID → tag, last tap counter). Server only.
    match /kitTags/{tagUid} {
      allow read, write: if false;
    }

    // One ticket per genuine tap of a secure stamp tag, issued by the server. Its client spends
    // (deletes) it in the same write as the stamp it pays for; ticketOk() checks that.
    match /stampTickets/{ticketId} {
      allow get: if signedIn() && resource.data.clientUid == uid();
      allow delete: if signedIn()
        && resource.data.clientUid == uid()
        && getAfter(cardPath(tagOf(resource.data.tagId).programId + '_' + uid())).data.lastTicketId == ticketId;
      allow list, create, update: if false;
    }
  }
}
