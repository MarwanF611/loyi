rules_version = '2';

// Stamps, cards and redemptions are only ever written by Cloud Functions
// (admin SDK bypasses these rules), so clients can never award themselves stamps.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Business owners must use a real account, not an anonymous client session.
    function isBusinessUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function ownsBusiness(businessId) {
      return isBusinessUser()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    // Writes to business-owned docs must keep ownerUid/businessId consistent and owned.
    function validOwnedWrite() {
      return request.resource.data.ownerUid == request.auth.uid
        && ownsBusiness(request.resource.data.businessId)
        && (resource == null
            || (resource.data.ownerUid == request.auth.uid
                && resource.data.businessId == request.resource.data.businessId));
    }

    match /businesses/{businessId} {
      allow read: if true; // name + colour are shown on client cards
      allow create: if isBusinessUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if isBusinessUser()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /programs/{programId} {
      allow read: if true; // clients need the name, stamp count and rewards
      allow create, update: if validOwnedWrite()
        && request.resource.data.stampsRequired is int
        && request.resource.data.stampsRequired >= 1
        && request.resource.data.stampsRequired <= 50
        && request.resource.data.stampCooldownMinutes is int
        && request.resource.data.stampCooldownMinutes >= 0
        && request.resource.data.rewards is list
        && request.resource.data.rewards.size() <= 20;
      allow delete: if false; // deactivate instead, cards reference programs
    }

    match /tags/{tagId} {
      // Clients never read tags directly; the `tap` function resolves them.
      allow read: if isBusinessUser() && resource.data.ownerUid == request.auth.uid;
      allow create: if validOwnedWrite()
        && request.resource.data.type in ['join', 'stamp']
        && get(/databases/$(database)/documents/programs/$(request.resource.data.programId)).data.businessId
           == request.resource.data.businessId;
      allow update: if validOwnedWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'label']);
      allow delete: if false;
    }

    match /cards/{cardId} {
      allow read: if signedIn()
        && (resource.data.clientUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /redemptions/{redemptionId} {
      allow read: if signedIn()
        && (resource.data.clientUid == request.auth.uid || resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /stampEvents/{eventId} {
      allow read: if isBusinessUser() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
  }
}
