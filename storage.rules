rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Business logos: public, shown on every client's card.
    match /logos/{businessId}/{file} {
      function isOwner() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
      }

      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if isOwner();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
